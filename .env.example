# CyberStream environment template — copy to .env and fill in.
# NEVER commit a real .env. This file contains placeholders only.

# Hot storage (relational)
DATABASE_URL=postgresql://cyberstream:cyberstream@postgres:5432/cyberstream

# Streaming
KAFKA_BROKER=kafka:29092
KAFKA_TOPIC_EVENTS=cyber-events
KAFKA_TOPIC_NORMALIZED=normalized-events
KAFKA_TOPIC_ALERTS=security-alerts

# Cold storage (HDFS-compatible / local Parquet fallback)
HDFS_URL=file:///data/events

# Auth
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Frontend
API_URL=http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:8001

# Simulator
EVENT_RATE=50
